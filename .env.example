# Shared local infrastructure
POSTGRES_DB=audio_notes
POSTGRES_USER=audio_notes
POSTGRES_PASSWORD=change-me-locally

# Backend
LOCAL_DEVELOPMENT_MODE=false
LOCAL_STORAGE_PATH=../work/local-storage
DATABASE_URL=postgresql+psycopg://audio_notes:change-me-locally@postgres:5432/audio_notes
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=audio-notes
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=change-me-locally
STORAGE_FORCE_PATH_STYLE=true
GEMINI_API_KEY=
GEMINI_DETECTION_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=300000
GNANI_API_KEY=
GNANI_API_URL=https://api.vachana.ai/stt/v3
GNANI_REQUEST_TIMEOUT_SECONDS=300
MAX_UPLOAD_BYTES=104857600
TASK_MAX_RETRIES=2

# Frontend (this URL is intentionally public; never put secrets in NEXT_PUBLIC_* values)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_REPOSITORY_URL=
